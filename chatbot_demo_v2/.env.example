# chatbot_demo_v2 환경변수 예시. 실제 값은 chatbot_demo_v2/.env 로 저장하세요(이 파일에 키 금지).
# 로딩 우선순위: 프로세스 env > chatbot_demo_v2/.env > 최상위 .env > 코드 기본값

# --- RAG(rag3x) 백엔드 ---
# RAGCORE_CONFIG 미지정 시 자동으로 chatbot_demo_v2/ragcore/rag3/config.yaml 사용.
# RAGCORE_CONFIG=
RAG_BACKEND=gemini            # gemini | ollama
RAG_DEEP_WARMUP=true         # 첫 질문 콜드로드(23s)를 기동 시점으로 앞당김

# --- 유사도 매칭 (자유 입력 → 모범 질답) ---
# 매칭 백엔드: semantic(임베딩+리랭커, 기본) | fuzz(문자 편집거리, 폴백)
#   semantic 은 data/faq_embeddings.json 이 필요하다 → scripts/build_faq_embeddings.py
SCENARIO_MATCH_BACKEND=semantic
# 아래 임계는 **의미 유사도 스케일**이다(문자 유사도 값 0.90/0.75 와 호환되지 않음).
# 근거: scripts/calibrate_faq_threshold.py 실측 — margin 이 핵심 판별자다.
SCENARIO_MATCH_THRESHOLD=0.80
SCENARIO_MATCH_MARGIN=0.30    # 1·2위 차. 모호 질문은 최대 0.272 라 여기서 걸린다

# --- clarify (HITL 되묻기) ---
CLARIFY_ENABLED=true
CLARIFY_MIN_SCORE=0.35        # 이 미만이면 도메인 밖으로 보고 RAG 로. 범위밖 질문은 최대 0.004

# --- 답변 합성(composer) ---
COMPOSER_RAG_ENABLED=true     # RAG 답변을 근거 종합 대화체로 정리
COMPOSER_FAQ_ENABLED=true     # FAQ 원문을 상담체로 재구성(원문은 항상 동봉)
PERSONA_PROMPTS_ENABLED=true  # prompts/persona/* 선택적 페르소나·응답정책 사용

# --- 후속질문 재작성(contextualize) ---
CONTEXTUALIZE_ENABLED=true

# --- 답변 해결도 판정 + 에스컬레이션(grader) ---
GRADER_ENABLED=true

# --- RAG 결과 캐시(같은 질문 반복 시 즉답) ---
RAG_CACHE_TTL_S=3600          # 0 이면 비활성

# --- 웹검색 (기본 비활성 · 마지막 보루) ---
# 시나리오/FAQ/RAG 가 **모두** 답을 못 냈을 때만, 그리고 질문이 상담 범위 안일 때만 호출된다.
# ※ 켜면 Google 검색 grounding 호출당 과금이 발생할 수 있다(무료 티어에서는 사용 불가할 수 있음).
WEB_SEARCH_ENABLED=false
# in_domain_unresolved: 웹검색 직전 도메인 게이트(LLM 1회)로 범위 밖 질문을 차단(권장)
# any_unresolved     : 게이트 없이 미해결이면 무조건 웹검색(실험/디버깅용 — 비용 주의)
WEB_SEARCH_SCOPE=in_domain_unresolved
WEB_SEARCH_PROVIDER=gemini_grounding    # gemini_grounding | mock | disabled
WEB_SEARCH_MODEL=gemini-3.1-flash-lite  # Google 검색 grounding 지원 모델이어야 함
WEB_SEARCH_TIMEOUT_S=30
WEB_SEARCH_MAX_SOURCES=5
WEB_SEARCH_DAILY_BUDGET=100             # 프로세스 기준 하루 최대 호출 수(0=무제한)
# 웹검색 전용 API 키(선택). 검색 grounding 은 **유료(결제 활성화) 티어에서만** 동작하고
# 무료 키로 호출하면 429 RESOURCE_EXHAUSTED 가 돌아온다. 그래서 결제를 뚫어 둔 키를
# 여기에 따로 넣으면 웹검색만 그 키로 나가고, RAG·게이트 등 나머지는 GEMINI_API_KEY 를 계속 쓴다.
# 비워 두면 GEMINI_API_KEY 로 폴백한다.
# WEB_SEARCH_GEMINI_API_KEY=

# --- LangSmith 추적 ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=school-network-chatbot-demo-v2
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- 서버 ---
DEMO_PORT=8002               # v1(8001)과 병행 실행 가능

# --- Gemini (RAG_BACKEND=gemini 일 때 필요) ---
# 최상위 .env의 GEMINI_API_KEY를 자동으로 읽으므로 보통 여기 넣지 않아도 됩니다.
# GEMINI_API_KEY=
